# ===== LLM設定 =====
LLM_API_KEY=dummy-key
LLM_API_BASE=http://192.168.0.23:1234/v1
LLM_MODEL_NAME=qwen3-vl-8b-instruct

# ===== Embedding設定 =====
EMBED_API_KEY=dummy-key
EMBED_API_BASE=http://192.168.0.23:1234/v1
EMBED_MODEL_NAME=text-embedding-mxbai-embed-large-v1

# ===== Minecraft 接続設定 =====
MINECRAFT_HOST=192.168.0.9
MINECRAFT_PORT=25565
MINECRAFT_AUTH=offline
# 空なら mineflayer の自動判定。同一プロトコルに複数バージョンがある場合、
# minecraft-data にデータのある版を明示する必要がある（例: 26.1）
MINECRAFT_VERSION=

# ===== Discord通知 =====
DISCORD_WEBHOOK_URL=

# ===== unj連携 =====
# ゲーム内チャットをunj（うんでも実況J / board_id=1）へスレ実況として投稿する。
# どちらか空なら投稿処理自体をスキップする（unj-relay.tsの受信側も連動して止まる）。
UNJ_BASE_URL=
UNJ_ADMIN_API_KEY=
# unj→Minecraft方向。onj-minecraftはLAN内で動く前提でunjからpushできないため、
# この間隔(ms)でunjに新着人間発言を尋ねに行く。既定 8000。
UNJ_RELAY_POLL_MS=
# 中継発言を誰の口(minecraftName)で喋らせるか。空なら起動順で最初のエージェント。
UNJ_RELAY_MINECRAFT_NAME=
# 一時的に両方向の転送だけ止めたいとき用（BASE_URL/API_KEYは残したまま）。
# true/1で無効化。既定false。
UNJ_RELAY_DISABLED=

# ===== 会話設定 =====
# 話しかけへの返答は、行動決定とは別のモデルに投げられる（src/core/conversation.ts）。
# 空欄なら上の LLM_* をそのまま使う。別のモデルを使いたいときだけ埋めること。
#
# 注意: LM Studio は要求されたモデルを都度ロードするので、思考用と別のモデルを
# 指定すると、判断のたびにロードとアンロードが往復する。VRAM に両方載らない
# 環境では、指定しない（＝同じモデルを使う）方が速い。
CHAT_API_KEY=
CHAT_API_BASE=
CHAT_MODEL_NAME=
# 会話は温度0だと同じ返事を繰り返す。既定 0.7。
CHAT_TEMPERATURE=
# ゲーム内チャットに流す最大文字数。既定 160。
CHAT_MAX_CHARS=
# 返事が返らないまま詰まるのを防ぐ上限(ms)。既定 45000。
# 別モデルを指定してロードが挟まる構成では、これを伸ばす必要がある。
CHAT_TIMEOUT_MS=
# 受けた依頼を行動として追いかけ続ける時間(ms)。既定 600000（10分）。
CHAT_REQUEST_TTL_MS=

# ===== エージェントの発言 =====
# 話しかけへの返答とは別に、自分の計画をゲーム内チャットに流す機能。既定はOFF。
# 1体だけで動かす場合は誰にも届かないため、複数体で会話させるときだけ 1 にする
ENABLE_CHAT=

# ===== 統合版(Realms) =====
# 招待コード。URL を丸ごと貼ってよい（sidecar 側でコードだけ取り出す）。
#   https://realms.gg/XXXX                          の短縮形
#   https://www.minecraft.net/…/open?inviteCode=XXX のクエリ形
# どちらも可。
REALM_INVITE=
# 使うアカウントはトークンキャッシュの置き場所で決まる。
# 検証は必ず一般アカウント(kusabot2361)で行うこと。管理者アカウントで
# 世界を壊す検証を回さないため。
BEDROCK_TOKEN_CACHE=.bedrock-auth/gophertunnel-kusabot.json
#
# 招待コードが手元に無くても、そのアカウントが既に参加している Realm なら
# 一覧から ID で繋げる。招待リンクが見つからないだけで検証が止まらないように。
#   ./sidecar/bedrock/bin/onj-bedrock.exe -list-realms #       -token-cache .bedrock-auth/gophertunnel-kusabot.json
#   → {"event":"realm","data":{"id":32640161,"name":"kusaワールド(復旧済み)",...}}
#   繋ぐときは -realm-id 32640161 を渡す（-invite の代わり）。

# 夜に帰る寝床。人が湧きつぶした部屋の座標を x,y,z で指定する。
# 未設定なら、近くのベッドから自動で選ぶ（屋根のあるものを優先）。
# 自動選択は「一番近いベッド」になりがちで、野ざらしのベッドを掴むと
# 毎晩そこで殺される。安全な場所があるなら指定した方が確実。
HOME_POSITION=
